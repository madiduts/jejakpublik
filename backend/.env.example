PORT=3000
# Neon PostgreSQL Connection URL Placeholder
DATABASE_URL=postgresql://username:***@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key
JWT_SECRET=jejakpublik-secret-token-mia2026-secure-key

# Demo Accounts Configuration (Khusus Mode Evaluasi & Presentasi)
ENABLE_DEMO_ACCOUNTS=true
DEMO_WARGA_NAME=Warga Peduli Jakarta
DEMO_WARGA_EMAIL=warga@jejakpublik.id
DEMO_WARGA_PASSWORD=warga123
DEMO_MODERATOR_NAME=Tim Auditor JejakPublik
DEMO_MODERATOR_EMAIL=moderator@jejakpublik.id
DEMO_MODERATOR_PASSWORD=admin123

# Cloudflare R2 Object Storage (Upload Bukti Foto / Dokumen Warga)
# Masukkan kredensial Cloudflare R2 di bawah ini:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=jejakpublik-evidence
